		annotation SummarizationSetBy = Automatic

	column Week_Label = ```
			
			VAR CurrentDate = 'DateTable'[Date].[Date]
			VAR DayNum = DAY(CurrentDate)
			VAR WeekNum = CEILING(DayNum, 7) / 7
			VAR WeekStart = (WeekNum - 1) * 7 + 1
			
			-- Days in Month
			VAR YearNum = YEAR(CurrentDate)
			VAR MonthNum = MONTH(CurrentDate)
			
			VAR DaysInMonth =
			    DAY ( EOMONTH ( CurrentDate, 0 ) )
			
			-- Week End
			VAR WeekEnd =
			    SWITCH(
			        TRUE(),
			        WeekNum = 1, 7,
			        WeekNum = 2, 14,
			        WeekNum = 3, 21,
			        WeekNum = 4, 28,
			        WeekNum = 5, DaysInMonth,
			        DaysInMonth
			    )
			
			RETURN
			"Week " & WeekNum
			    & " (" &
			    FORMAT(CurrentDate, "MMMM")
			    & " "
			    & WeekStart
			    & "-"
			    & WeekEnd
			    & ")"
			
			```
		lineageTag: ef8809a3-54f4-4181-b377-7e3ac057b610
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column DaysInMonth = ```
			
			VAR _Year = YEAR('DateTable'[Date].[Date])
			VAR _Month = MONTH('DateTable'[Date].[Date])
			RETURN
			SWITCH(
			    TRUE(),
			    _Month = 2 &&
			        (MOD(_Year, 4) = 0 && (MOD(_Year,100) <> 0 || MOD(_Year,400) = 0)), 29,
			    _Month = 2, 28,
			    _Month IN {1,3,5,7,8,10,12}, 31,
			    _Month IN {4,6,9,11}, 30
			)
			
			```
		formatString: 0
		lineageTag: 32e1dbea-f83d-4afa-b358-ef5656263725
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

