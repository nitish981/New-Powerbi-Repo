	measure 'MoM% Pageview Interaction' =
			
			VAR _MinDate = MIN('DateTable'[Date])
			VAR _MaxDate = MAX('DateTable'[Date])
			
			VAR _CM =
			    CALCULATE(
			        SUM('Google Overall Share BI'[All_Conv___Google_Ads]),
			        FILTER(
			            'Google Overall Share BI',
			            CONTAINSSTRING('Google Overall Share BI'[Conversion_category_name__Google_Ads], "PAGE_VIEW")
			        )
			    )
			
			VAR _PM =
			    CALCULATE(
			        SUM('Google Overall Share BI'[All_Conv___Google_Ads]),
			        FILTER(
			            'Google Overall Share BI',
			            CONTAINSSTRING('Google Overall Share BI'[Conversion_category_name__Google_Ads], "PAGE_VIEW")
			        ),
			        DATESBETWEEN(
			            'DateTable'[Date],
			            EDATE(_MinDate, -1),
			            EDATE(_MaxDate, -1)
			        )
			    )
			
			RETURN
			DIVIDE(_CM - _PM, _PM)
		lineageTag: a51ed5e7-d457-4d95-9229-829cde8c6b76

		formatStringDefinition = "+0.00%;-0.00%;0.00%"

