table 'Google Measures'
	lineageTag: d8c18c70-98d9-493b-a136-a5d1449a6909

	measure Google_CTR = CALCULATE(DIVIDE(SUM('Google Overall Share BI'[Clicks]),SUM('Google Overall Share BI'[Impressions__Google_Ads])))
		formatString: 0%;-0%;0%
		lineageTag: 49a8e5a3-b920-4623-8f66-7ee99f8dbeee

	measure Google_CPC = CALCULATE(DIVIDE([Google Spent],SUM('Google Overall Share BI'[Clicks])))
		lineageTag: 99364666-8403-4ad7-b581-901ae3f56129

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MOM% G_Spent' =
			
			VAR _MinDate = MIN('DateTable'[Date])
			VAR _MaxDate = MAX('DateTable'[Date])
			
			VAR _CM = [Google Spent]
			
			VAR _PM =
			    CALCULATE(
			        SUM('Google Overall Share BI'[Cost]),
			        DATESBETWEEN(
			            'DateTable'[Date],
			            EDATE(_MinDate, -1),
			            EDATE(_MaxDate, -1)
			        )
			    )
			RETURN
			DIVIDE(_CM - _PM, _PM)
		lineageTag: 35347739-af82-4f9b-8158-fa1fa18876df

		formatStringDefinition = "+0.00%;-0.00%;0.00%"

	measure 'MOM% G_Revenue' =
			
			VAR _MinDate = MIN('DateTable'[Date])
			VAR _MaxDate = MAX('DateTable'[Date])
			
			VAR _CM = [Google Revenue]
			
			VAR _PM =
			    CALCULATE(
			        SUM('Google Overall Share BI'[Conv__Value__Google_Ads]),
			        DATESBETWEEN(
			            'DateTable'[Date],
			            EDATE(_MinDate, -1),
			            EDATE(_MaxDate, -1)
			        )
			    )
			RETURN
			DIVIDE(_CM - _PM, _PM)
		lineageTag: 4de27e0c-4ef1-4caa-9c0e-8a0a2a6043b2

		formatStringDefinition = "+0.00%;-0.00%;0.00%"

	measure 'MOM% G_ROAS' =
			
			VAR _MinDate = MIN('DateTable'[Date])
			VAR _MaxDate = MAX('DateTable'[Date])
			
			VAR _CM = [Google ROAS]
			
			VAR _PM =
			    CALCULATE(
			        DIVIDE([Google Revenue],[Google Spent],0),
			        DATESBETWEEN(
			            'DateTable'[Date],
			            EDATE(_MinDate, -1),
			            EDATE(_MaxDate, -1)
			        )
			    )
			RETURN
			DIVIDE(_CM - _PM, _PM)
		lineageTag: fa5c07cc-88be-4909-a5a2-b7052bced2b0

		formatStringDefinition = "+0.00%;-0.00%;0.00%"

	measure G_Impression = SUM('Google Overall Share BI'[Impressions__Google_Ads])
		formatString: 0
		lineageTag: b6c37cc0-fb1e-4aab-b438-3e351d130d4a

	measure Google_CPM = ([Google Spent] / [G_Impression]) *1000
		lineageTag: fefe3276-d7aa-48c7-b887-ac88a9e0e1e5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'G_Conversion Rate %' = SUM('Google Overall Share BI'[Conversions__Google_Ads]) / SUM('Google Overall Share BI'[Clicks__Google_Ads])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 99476910-a53e-4f16-8fd1-cbd4eaa44c36

	measure 'MOM% G_Impression' =
			
			VAR _MinDate = MIN('DateTable'[Date])
			VAR _MaxDate = MAX('DateTable'[Date])
			VAR _CM = [G_Impression]
			VAR _PM =
			    CALCULATE(
			        [G_Impression],
			        DATESBETWEEN(
			            'DateTable'[Date],
			            EDATE(_MinDate, -1),
			            EDATE(_MaxDate, -1)
			        )
			    )
			RETURN
			DIVIDE(_CM - _PM, _PM)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 71325944-95f7-4b93-b88d-d8c0238f8824

