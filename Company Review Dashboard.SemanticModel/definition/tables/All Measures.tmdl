	measure '85% Tier Msg' = ```
			
			VAR CurrentEarn = [Current Earnings] -- Your measure for current earnings
			
			-- Define your target fields/values
			VAR Tier1 = [Minimum Earnings Required (85%)]
			
			-- Calculate the remaining gaps
			VAR Gap1 = Tier1 - CurrentEarn
			
			
			RETURN
			SWITCH(
			    TRUE(),
			    -- If they haven't even hit Tier 1
			    CurrentEarn < Tier1, 
			        "🔒 Require " & FORMAT(Gap1, "#,##0") & " more earning to unlock",
			        
			    -- If they hit Tier 1 but are chasing Tier 2
			    CurrentEarn >= Tier1, 
			        "✅ Unlocked!"
			        
			)
			```
		lineageTag: cd5a29b1-5ade-4dd4-b34e-bed3beff24f9

	measure '90% Tier Msg' = ```
			
			VAR CurrentEarn = [Current Earnings] -- Your measure for current earnings
			
			-- Define your target fields/values
			VAR Tier2 = [Target Earnings]*0.9
			
