	measure PrevMonthReturns =
			
			CALCULATE(
			    SUM('Command Center Funnel  For Review Dashboard'[Returns__Shopify]),
			    FILTER(
			        'Command Center Funnel  For Review Dashboard',
			        DATEDIFF('Command Center Funnel  For Review Dashboard'[Order_Created_At__Shopify] , 'Command Center Funnel  For Review Dashboard'[Date], MONTH) >= 1
			    )
			)
		lineageTag: 2074d443-4c86-4bf5-98c9-6dfc3c32d972

		formatStringDefinition = ""

	measure 'Actual Sales' = [Total Sales] - [PrevMonthReturns]
		formatString: #,0
		lineageTag: f7560219-5c1b-4890-8acc-1feebe5a6ba4

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'ROI - Actual' = DIVIDE([Actual Sales] , [Total Spent])
		lineageTag: 7b00dcff-c38e-4d91-a2e4-99879584320f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MoM % (Same Date Range)' =
			
			VAR MinDate = MIN('Shopify Overall Share'[Date])
			VAR MaxDate = MAX('Shopify Overall Share'[Date])
			VAR CurrentSales =
			    CALCULATE(
			        SUM('Shopify Overall Share'[Total_Sales__Shopify]),
			        DATESBETWEEN('Shopify Overall Share'[Date], MinDate, MaxDate)
			    )
			VAR PrevSales =
			    CALCULATE(
			        SUM('Shopify Overall Share'[Total_Sales__Shopify]),
			        DATESBETWEEN(
			            'Shopify Overall Share'[Date],
			            EDATE(MinDate, -1),
			            EDATE(MaxDate, -1)
			        )
			    )
			RETURN
			IF(
			    NOT ISBLANK(PrevSales),
			    DIVIDE(CurrentSales - PrevSales, PrevSales),
			    BLANK()
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d749d78a-a138-413a-9374-58e4fe988644

