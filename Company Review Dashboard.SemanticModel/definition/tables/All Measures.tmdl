	measure 'Team Achieved Earning %' = [Net Revenue]/[Target Earnings]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 06667331-07ee-4b74-8c7b-ecb8e8f55eca

	measure 'Net Team Incentive Amount (New)' =
			
			VAR Achieved = [Growify Earnings Achieved Net (Rev) %]
			VAR SIAmount = [Net Revenue]
			RETURN
			    SWITCH(
			        TRUE(),
			        Achieved > 1.20, SIAmount * (0.05 * 0.65),        -- 5%
			        Achieved > 1.00, SIAmount * (0.04 * 0.65),        -- 4%
			        Achieved > 0.90, SIAmount * (0.03 * 0.65),        -- 3%
			        Achieved > 0.85, SIAmount * (0.015 * 0.65),       -- 1.5%
			        0 -- Default if <= 85%
			    )
		lineageTag: 457797cd-f293-406b-8eff-d1afaddcb5fc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Growify Earnings Achieved Net (Rev) %' =
			
