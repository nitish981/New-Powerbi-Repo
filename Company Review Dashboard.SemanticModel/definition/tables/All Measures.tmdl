	measure 'Target Incentive' = ```
			(
			VAR RateTable =
			    ADDCOLUMNS(
			        'Growify''s Sales Incentive',
			
			        "Rate",
			        VAR GT = 'Growify''s Sales Incentive'[Growth Target]
			        VAR GB = 'Growify''s Sales Incentive'[Growth Budget]
			        VAR Brand = 'Growify''s Sales Incentive'[Brands]
			        VAR YM = 'Growify''s Sales Incentive'[Date]
			
			        RETURN
			        SWITCH(
			            TRUE(),
			
			            /* NOTEBOOK */
			            CONTAINSSTRING(Brand, "Notebook") && GT < 2500000, 0.03,
			            CONTAINSSTRING(Brand, "Notebook") && GT >= 2500000 && GT < 3500000, 0.04,
			            CONTAINSSTRING(Brand, "Notebook") && GT >= 3500000, 0.05,
			
			                        /* SAMANT CHAUHAN */
			            CONTAINSSTRING(Brand, "Samant Chauhan") && GT > 5000000, ((GT - 5000000) * 0.05) / GT,
			
			                        /* AUM */
			            CONTAINSSTRING(Brand, "AUM") && GT/GB < 3, 0.05,
			            CONTAINSSTRING(Brand, "AUM") && GT/GB > 3 && GT/GB < 4, 0.06,
			            CONTAINSSTRING(Brand, "AUM") && GT/GB > 4 && GT/GB < 5, 0.07,
			            CONTAINSSTRING(Brand, "AUM") && GT/GB > 5 && GT/GB < 6, 0.08,
			            CONTAINSSTRING(Brand, "AUM") && GT/GB > 6 && GT/GB < 7, 0.09,
			            CONTAINSSTRING(Brand, "AUM") && GT/GB > 7 , 0.1,
			            
			            /* RAJI RAMNIQ (SLAB-BASED INCREMENTAL) */
			            CONTAINSSTRING(Brand, "Raji Ramniq") && GT <= 1000000, 0,
			            CONTAINSSTRING(Brand, "Raji Ramniq") && GT > 1000000 && GT <= 3000000, 
			                ((GT - 1000000) * 0.04) / GT,
			            CONTAINSSTRING(Brand, "Raji Ramniq") && GT > 3000000 && GT <= 5000000, 
			                (((GT - 3000000) * 0.05) + (2000000 * 0.04)) / GT,
			            CONTAINSSTRING(Brand, "Raji Ramniq") && GT > 5000000, 
			                (((GT - 5000000) * 0.06) + (2000000 * 0.05) + (2000000 * 0.04)) / GT,
			            
			            
			            /* ATHLETIFREAK USA */
			            CONTAINSSTRING(Brand, "Athletifreak USA"), 0.04,
			
			            /* CALLING JUNE */
			            CONTAINSSTRING(Brand, "Calling June") && GT / GB >= 3, 0.065,
			            CONTAINSSTRING(Brand, "Calling June") && GT / GB >= 2.5, 0.04,
			
			            /* RIDHI MEHRA */
			            CONTAINSSTRING(Brand, "Ridhi Mehra"), 0.08,
			
			            /* AEROHAVEN */
			            CONTAINSSTRING(Brand, "Aerohaven") && GT <= 1500000, 0.03,
			            CONTAINSSTRING(Brand, "Aerohaven") && GT > 1500000 && GT <= 3000000, 0.04,
			            CONTAINSSTRING(Brand, "Aerohaven") && GT > 3000000, 0.05,
			
			            /* TARUN TAHILIANI */
			            CONTAINSSTRING(Brand, "Tarun Tahiliani"), 0.05,
			
			            /* PAYAL SINGHAL */
			            CONTAINSSTRING(Brand, "Payal Singhal"), 0.06,
			
			            /* DRZYA */
			            CONTAINSSTRING(Brand, "Drzya"), 0.04,
			
			            /* ZABELLA */
			            CONTAINSSTRING(Brand, "Zabella") && GT > 1500000, 0.04,
			
			            /* ROZA PRET */
			            CONTAINSSTRING(Brand, "Roza Pret") && GT > 3500000 && GT <= 6000000, 0.035,
			            CONTAINSSTRING(Brand, "Roza Pret") && GT > 6000000 && GT <= 10000000, 0.045,
			            CONTAINSSTRING(Brand, "Roza Pret") && GT > 10000000, 0.055,
			
			            /* BEGUM PRET */
			            CONTAINSSTRING(Brand, "Begum Pret") && GT > 2000000 && GT <= 4000000, 0.04,
			            CONTAINSSTRING(Brand, "Begum Pret") && GT > 4000000 && GT <= 6000000, 0.05,
			            CONTAINSSTRING(Brand, "Begum Pret") && GT > 6000000, 0.06,
			
			            /* SUNEET VARMA */
			            CONTAINSSTRING(Brand, "Suneet Varma") && GT <= 5000000, 0.06,
			            CONTAINSSTRING(Brand, "Suneet Varma") && GT > 5000000 && GT <= 10000000, 0.05,
			            CONTAINSSTRING(Brand, "Suneet Varma") && GT > 10000000, 0.04,
			
			            /* NIDHIKA SHEKHAR */
			            CONTAINSSTRING(Brand, "Nidhika Shekhar") && GT <= 1000000, 0.04,
			            CONTAINSSTRING(Brand, "Nidhika Shekhar") && GT > 1000000 && GT <= 3000000, 0.05,
			            CONTAINSSTRING(Brand, "Nidhika Shekhar") && GT > 3000000, 0.06,
			
			            /* SAFAA */
			            CONTAINSSTRING(Brand, "Safaa") &&
			            MONTH(YM) > 7 &&
			            GT - 900000 >= 2500000, 0.07,
			
			            CONTAINSSTRING(Brand, "Safaa") &&
			            MONTH(YM) > 7 &&
			            GT - 900000 >= 900000, 0.05,
			
			            CONTAINSSTRING(Brand, "Safaa") && GT >= 2500000, 0.07,
			            CONTAINSSTRING(Brand, "Safaa") && GT >= 900000, 0.05,
			
			            /* DEFAULT */
			            'Growify''s Sales Incentive'[Growify's Sales Incentive %]
			        )
			    )
			
			RETURN
			COALESCE(
			    SUMX(
			        RateTable,
			        [Rate] * 'Growify''s Sales Incentive'[Growth Target]
			    ),
			    0
			))/1.22
			```
		formatString: #,0
		lineageTag: fa4d1b47-36e7-442d-b4c1-3fbc2ffb726e

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Shipping Charges' = ```
			
			SUMX (
			    VALUES ( 'Growify''s Sales Incentive'[Brands] ),
			    VAR Gross_Sale = [Gross Sales]
			    VAR Brand = SELECTEDVALUE ( 'Growify''s Sales Incentive'[Brands] )
			    VAR Shopify_Shipping =
			        SUM ( 'Command Center Funnel  For Review Dashboard'[Shipping__Shopify] )
			    RETURN
			        SWITCH (
			            TRUE (),
			            Brand IN { "Zabella", "Angad Singh" }, Gross_Sale * 0.06,
			            Shopify_Shipping
			        )
			)
			
			```
		lineageTag: 47a305ca-68a7-44ba-a3e0-a203b50a5b61

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cal. Net Sales' = ```
			([Store + Total Sales]-[Shipping Charges])/1.18 
			```
		lineageTag: ba5129a9-d9b6-4dd3-b85d-1adadc685d56

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Incentive Amount' = ```
			
			SUMX(
			    VALUES('Growify''s Sales Incentive'[Brands]),
			    VAR BrandName = 'Growify''s Sales Incentive'[Brands]
			    VAR NS = [Cal. Net Sales]
			    VAR Sales = CALCULATE(SUM('Command Center Funnel  For Review Dashboard'[Net_Sales__Shopify]) + SUM('Store Sales'[Net Sales]))
			    VAR TSales = CALCULATE(SUM('Command Center Funnel  For Review Dashboard'[Total_Sales__Shopify]) + SUM('Store Sales'[Net Sales]))
			    VAR Store = [Store Sales] / 1.18
			    VAR ClientTarget = [Client Target]
			    VAR Ads = [Total Spent]
			    VAR TotalSales = NS
			    VAR SI = 
			        AVERAGEX(
			            VALUES('Growify''s Sales Incentive'[Date]), 
			            [Growify's Sales Incentive %]
			        )
			    
			    -- ALL mid-switch variables moved up here to prevent syntax crashes
			    VAR ROI = DIVIDE(TSales, Ads)
			    VAR Achievement = DIVIDE(Sales, ClientTarget)
			    VAR TTAchievement = DIVIDE(TSales, ClientTarget)
			    
			    RETURN
			    SWITCH(
			        TRUE(),
			
			        BrandName = "Samant Chauhan",
			        IF(Sales > 5000000, (NS - 5000000) * 0.05, 0),
			
			        BrandName = "AUM",
			        SWITCH(
			            TRUE(),
			            ROI < 3, NS * 0.05,
			            ROI >= 3 && ROI < 4, NS * 0.06,
			            ROI >= 4 && ROI < 5, NS * 0.07,
			            ROI >= 5 && ROI < 6, NS * 0.08,
			            ROI >= 6 && ROI < 7, NS * 0.09,
			            ROI >= 7,  NS * 0.1                    
			        ),
			    
			        BrandName = "Outhouse Jewellery",
			        IF(Sales > 8000000, (NS - 8000000) * 0.04, 0),
			
			        BrandName = "AFEW",
			        IF(NS > 0, NS * 0.08, 0),
			
			        /* ---------------- PAYAL SINGHAL ---------------- */
			        BrandName = "Payal Singhal",
			        IF(NS * 0.06 >= 75000, NS * 0.06, 75000),
			
			        /* ---------------- RIDHI MEHRA ---------------- */
			        BrandName = "Ridhi Mehra",
			        SWITCH(
			            TRUE(),
			            Achievement < 1, 0.05 * NS,
			            Achievement = 1, 0.06 * NS,
			            Achievement > 1 && Achievement <= 1.2, 0.07 * NS,
			            Achievement > 1.2, 0.08 * NS
			        ),
			
			        /* ---------------- DRZYA ---------------- */
			        BrandName = "Drzya",
			        SWITCH(
			            TRUE(),
			            NS <= 700000, 0,
			            NS <= 1200000, (NS - 700000) * 0.01,
			            NS <= 1800000, (NS - 1200000) * 0.02 + (500000 * 0.01),
			            NS <= 2500000, (NS - 1800000) * 0.03 + (600000 * 0.02) + (500000 * 0.01),
			            NS > 2500000,  (NS - 2500000) * 0.04 + (700000 * 0.03) + (600000 * 0.02) + (500000 * 0.01)
			        ),
			
			        /* ---------------- RAJI RAMNIQ (SLAB-BASED) ---------------- */
			        BrandName = "Raji Ramniq",
			        SWITCH(
			            TRUE(),
			            NS <= 1000000, 0,
			            NS <= 3000000, (NS - 1000000) * 0.04,
			            NS <= 5000000, (NS - 3000000) * 0.05 + (2000000 * 0.04),
			            NS > 5000000,  (NS - 5000000) * 0.06 + (2000000 * 0.05) + (2000000 * 0.04)
			        ),
			        
			        BrandName = "Roza Pret",
			        SWITCH(
			            TRUE(),
			            NS > 3500000 && NS <= 6000000, ((NS - 3500000) / 1.18) * 0.035,
			            NS > 6000000 && NS <= 10000000, ((6000000 - 3500000) / 1.18) * 0.035 + ((NS - 6000000) / 1.18) * 0.045,
			            NS > 10000000, ((6000000 - 3500000) / 1.18) * 0.035 + ((10000000 - 6000000) / 1.18) * 0.045 + ((NS - 10000000) / 1.18) * 0.055
			        ),
			            
			        BrandName = "Begum Pret",
			     
			        SWITCH(
			            TRUE(),
			            NS > 2000000 && NS <= 4000000, (NS - 2000000) * 0.04,
			            NS > 4000000 && NS <= 6000000, (4000000 - 2000000) * 0.04 + ((NS - 4000000)) * 0.05,
			            NS > 6000000, ((4000000 - 2000000)) * 0.04 + ((6000000 - 4000000)) * 0.05 + ((NS - 6000000)) * 0.06
			        ),
			            
			        /* ---------------- TARUN TAHILIANI ---------------- */
			        BrandName = "Tarun Tahiliani",
			        SWITCH(
			            TRUE(),
			            TTAchievement < 0.8, 0.04 * TotalSales,
			            TTAchievement < 1,   0.05 * TotalSales,
			            TTAchievement < 1.1, 0.06 * TotalSales,
			            TTAchievement < 1.25, 0.07 * TotalSales,
			            TTAchievement >= 1.25, 0.08 * TotalSales
			        ),
			
			        /* ---------------- SAFaa ---------------- */
			        BrandName = "Safaa World",
			        SWITCH(
			            TRUE(),
			            NS < 900000, 0,
			            NS < 2500000, (NS - 900000) * 0.05,
			            NS >= 2500000, (NS - 2500000) * 0.07 + (1600000 * 0.05)
			        ),
			
			        BrandName = "Sia Bridal",
			        IF(TotalSales > 0, SI * Sales, 0),
			
			        BrandName = "Shaira Fashion Dubai",
			        IF(TotalSales > 0, SI * (Sales / 1.05), 0),
			            
			        /* ---------------- DEFAULT ---------------- */
			        SI * TotalSales
			    )
			)
			```
		lineageTag: 4081fef7-9fd0-44ed-a2e6-90635d00d87a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

