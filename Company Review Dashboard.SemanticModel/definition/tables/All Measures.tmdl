	measure 'Team Incentive Amount' =
			
			VAR Achieved = [Growify Earnings Achieved %]
			VAR SIAmount = [Current Earnings]
			RETURN
			    SWITCH(
			        TRUE(),
			        Achieved > 1.20, SIAmount * (0.05 * 0.65),        -- 5%
			        Achieved > 1.00, SIAmount * (0.04 * 0.65),        -- 4%
			        Achieved > 0.90, SIAmount * (0.03 * 0.65),        -- 3%
			        Achieved > 0.85, SIAmount * (0.015 * 0.65),       -- 1.5%
			        0 -- Default if <= 85%
			    )
		lineageTag: 13b2da31-a124-4a6c-beed-9910c3af9b5f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Team Incentive At 85%' = 0.015 * 0.65 * [Target Earnings]*0.85
