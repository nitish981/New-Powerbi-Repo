	measure 'Net Current Earnings' = SUM('Profitability - Dashboard - 2022_26 (2)'[Gross])/1.18
		formatString: #,0
		lineageTag: addd294a-180b-490d-9061-ce64ef006619

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Net Team Incentive Amount' =
			
			VAR Achieved = [Sales % Achieved (Growth)]
			VAR SIAmount = [Net Current Earnings]
			RETURN
			    SWITCH(
			        TRUE(),
			        Achieved > 1.20, SIAmount * (0.05 * 0.65),        -- 5%
			        Achieved > 1.00, SIAmount * (0.04 * 0.65),        -- 4%
			        Achieved > 0.90, SIAmount * (0.03 * 0.65),        -- 3%
			        Achieved > 0.85, SIAmount * (0.015 * 0.65),       -- 1.5%
			        0 -- Default if <= 85%
			    )
		formatString: #,0
		lineageTag: 19b1a897-e492-41ac-9df3-f72e842e7053

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'First Revenue Date' = ```
			
			VAR _Client =
			    SELECTEDVALUE('Profitability - Dashboard - 2022_26 (2)'[Brand Name])
			RETURN
			CALCULATE(
			    MIN('Profitability - Dashboard - 2022_26 (2)'[Date]),
			    FILTER(
			        ALL('Profitability - Dashboard - 2022_26 (2)'),
			        'Profitability - Dashboard - 2022_26 (2)'[Brand Name] = _Client &&
			        [Net Current Earnings] > 0
			    )
			)
			
			```
		formatString: General Date
		lineageTag: 5994b363-8395-4a5e-a47a-e0bf20e99af7

	measure 'Is New Client' = ```
			
			VAR FirstDate =
			    CALCULATE(
			        MIN('Profitability - Dashboard - 2022_26 (2)'[Date]),
			        FILTER(
			            ALL('Profitability - Dashboard - 2022_26 (2)'),
			            'Profitability - Dashboard - 2022_26 (2)'[Brand Name]
			                = EARLIER('Profitability - Dashboard - 2022_26 (2)') &&
			            'Profitability - Dashboard - 2022_26 (2)'[Net_Current_Earning] > 0
			        )
			    )
			RETURN
			IF(
			    'Profitability - Dashboard - 2022_26 (2)'[Date] = FirstDate &&
			    'Profitability - Dashboard - 2022_26 (2)'[Net_Current_Earning] > 0,
			    "New Client",
			    "Old Client"
			)
			
			```
		lineageTag: fd6bb964-d1e2-4156-ab19-d6ef34928bf3

