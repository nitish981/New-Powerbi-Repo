			-- 1. Identify the Brand Manager currently selected in your slicer
			VAR SelectedManager = SELECTEDVALUE('Growify''s Sales Incentive'[FB Managers])
			
			-- 2. Define your 4 Team Leads (Replace with actual names)
			VAR TeamLeads = {"Vishal", "Shravya", "Deepak", "Arpit"}
			
			-- 3. Check if the selected manager is one of the leads
			VAR IsLead = SelectedManager IN TeamLeads
			
			-- 4. Calculate the pool and the count for the denominator
			VAR TotalPool = CALCULATE([Net Team Incentive Amount],REMOVEFILTERS('Growify''s Sales Incentive'[Brand Managers],'Growify''s Sales Incentive'[FB Managers]))
			VAR TotalStaffCount = CALCULATE([Total Members Count],REMOVEFILTERS('Growify''s Sales Incentive'[Brand Managers],'Growify''s Sales Incentive'[FB Managers]))
			VAR MemberDenominator = TotalStaffCount - 1
			
			RETURN
			
			-- Otherwise, they are a member: they get the 80% split (if a lead exists) 
			-- or a standard split if the manager isn't a lead
			IF(
			    IsLead, 
			    TotalPool * 0.20,
			    (TotalPool * 0.80) / MemberDenominator
			)
			```
