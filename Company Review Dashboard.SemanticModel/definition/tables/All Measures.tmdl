	measure 'BM Incentive' = ```
			
			-- 1. Identify the Brand Manager currently selected in your slicer
			VAR SelectedManager = SELECTEDVALUE('Growify''s Sales Incentive'[Brand Managers])
			
			-- 2. Define your 4 Team Leads (Replace with actual names)
			VAR TeamLeads = {"Vishal", "Shravya", "Deepak", "Arpit"}
			
			-- 3. Check if the selected manager is one of the leads
			VAR IsLead = SelectedManager IN TeamLeads
			
			-- 4. Calculate the pool and the count for the denominator
			VAR TotalPool = CALCULATE([Team Incentive Amount],REMOVEFILTERS('Growify''s Sales Incentive'[Brand Managers],'Growify''s Sales Incentive'[FB Managers]))
			VAR TotalStaffCount = CALCULATE([Total Members Count],REMOVEFILTERS('Growify''s Sales Incentive'[Brand Managers],'Growify''s Sales Incentive'[FB Managers]))
			VAR MemberDenominator = TotalStaffCount - 1
			
			RETURN
			
			-- Otherwise, they are a member: they get the 80% split (if a lead exists) 
			-- or a standard split if the manager isn't a lead
			IF(
			    IsLead, 
			    TotalPool * 0.20,
			    (TotalPool * 0.80) / MemberDenominator
			)
			```
		lineageTag: d5e512bf-69c9-4bd2-b96e-251847b7df18

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Members Count' = ```
			
			VAR BrandMgrs =
			    FILTER(
			        DISTINCT('Growify''s Sales Incentive'[Brand Managers]),
			        NOT ISBLANK('Growify''s Sales Incentive'[Brand Managers])
			    )
			
			VAR MetaMgrs =
			    FILTER(
			        DISTINCT('Growify''s Sales Incentive'[FB Managers]),
			        NOT ISBLANK('Growify''s Sales Incentive'[FB Managers])
			    )
			-- 2. Define your 4 Team Leads (Replace with actual names)
			VAR TeamLeads = {"Vishal", "Shravya", "Deepak", "Arpit"}
			
			VAR UniqueList =
			    DISTINCT(UNION(BrandMgrs, MetaMgrs))
			
			
			VAR LeadPresent =
			    COUNTROWS(
			        INTERSECT(
			            UniqueList,
			            TeamLeads
			        )
			    ) > 0
			
			RETURN
			IF(
			    LeadPresent,
			    COUNTROWS(UniqueList),
			    COUNTROWS(UniqueList) + 1
			)
			
			```
		formatString: 0
		lineageTag: 9be4c6da-08a0-40a8-87d9-4be6f58835d5

