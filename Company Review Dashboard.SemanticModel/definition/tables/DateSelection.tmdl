		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Month Name' = FORMAT('DateSelection'[Date], "MMMM")
		lineageTag: 2836fccd-672d-41dc-8ee7-995f50015a6d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column SortOrder
		formatString: 0
		lineageTag: 3fbc4670-68d2-4fbb-ba95-1610e9416e5d
		summarizeBy: sum
		isNameInferred
		sourceColumn: [SortOrder]

		annotation SummarizationSetBy = Automatic

	partition DateSelection = calculated
		mode: import
		source = ```
				
				VAR TodayDate = TODAY()
				
				VAR StartOfThisMonth = DATE( YEAR(TodayDate), MONTH(TodayDate), 1 )
				VAR StartOfThisYear  = DATE( YEAR(TodayDate), 1, 1 )
				
				VAR Last3_Start = EDATE(StartOfThisMonth, -3)
				VAR Last3_End   = EOMONTH(StartOfThisMonth, -1)
				
				VAR Last6_Start = EDATE(StartOfThisMonth, -6)
				VAR Last6_End   = EOMONTH(StartOfThisMonth, -1)
				
				VAR Result =
				    UNION(
				        -- MTD
				        ADDCOLUMNS(
				            CALENDAR(StartOfThisMonth, TodayDate),
				            "Selection", "MTD",
				            "SortOrder", 1
				        ),
				
				        -- Last 3 Months
				        ADDCOLUMNS(
				            CALENDAR(Last3_Start, Last3_End),
				            "Selection", "Last 3 Months",
				            "SortOrder", 2
				        ),
				
				        -- Last 6 Months
				        ADDCOLUMNS(
				            CALENDAR(Last6_Start, Last6_End),
				            "Selection", "Last 6 Months",
				            "SortOrder", 3
				        ),
				
				        -- YTD
				        ADDCOLUMNS(
				            CALENDAR(StartOfThisYear, TodayDate),
				            "Selection", "YTD",
				            "SortOrder", 4
				        )
				    )
				RETURN
				Result
				
				```

	annotation PBI_Id = e97c2e2c71e44da9b54ee13b32e228d5

