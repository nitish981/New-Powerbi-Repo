			formatStringDefinition = "+0.00%;-0.00%;0.00%"

		measure 'New Customers' = ```

				VAR _MinDate = MIN('DateTable'[Date].[Date])
				VAR _MaxDate = MAX('DateTable'[Date].[Date])
				RETURN
				CALCULATE(
				    DISTINCTCOUNT('Shopify Overall Share'[Customer_ID__Shopify]),
				    FILTER(
				        VALUES('Shopify Overall Share'[Customer_ID__Shopify]),
				        CALCULATE(MIN('Shopify Overall Share'[Order_Created_At__Shopify])) >= _MinDate &&
				        CALCULATE(MIN('Shopify Overall Share'[Order_Created_At__Shopify])) <= _MaxDate
				    )
				)
				```
			formatString: 0
			lineageTag: 741a9bd2-5014-4268-84dc-0055431d3f63

		measure 'Returning Customers' = ```

				VAR _MinDate = MIN('DateTable'[Date].[Date])
				VAR _MaxDate = MAX('DateTable'[Date].[Date])
				RETURN
				CALCULATE(
				    DISTINCTCOUNT('Shopify Overall Share'[Customer_ID__Shopify]),
				    FILTER(
				        VALUES('Shopify Overall Share'[Customer_ID__Shopify]),
				        CALCULATE(MIN('Shopify Overall Share'[Order_Created_At__Shopify])) < _MinDate
				    )
				)
				```
