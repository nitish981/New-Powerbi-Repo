			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure per_day_targer = ```

				   VAR _result = ([Projected Target] - [Total Sales]) /
				    (MAX('DateTable'[DaysInMonth]) - MAX('DateTable'[Ndays]))
				    RETURN
				    IF(ISBLANK(_result),0,_result)
				```
			lineageTag: 111aa6d4-5015-4ebd-b45b-b4be508e7da8

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure Target_ROI = ```

				 var _result = [Growth Target] / [Projected Spent]
				 RETURN
				 IF(ISBLANK(_result),0 ,_result)
				```
			lineageTag: 0103aeaa-dfe8-41f5-b55f-00324b300e47

			annotation PBI_FormatHint = {"isGeneralNumber":true}
	ref table 'PreviousPeriod Measures'

		measure 'MOM% Meta ROAS' = ```

				VAR _MinDate = MIN('DateTable'[Date])
				VAR _MaxDate = MAX('DateTable'[Date])

				VAR _CM = [Meta ROAS]   -- Current selected period ROAS

				VAR _PM =
				    CALCULATE(
				        DIVIDE([Meta Revenue], [Meta Spent], 0),
				        DATESBETWEEN(
				            'DateTable'[Date],
				            EDATE(_MinDate, -1),
				            EDATE(_MaxDate, -1)
				        )
				    )
				RETURN
				DIVIDE(_CM - _PM, _PM)
				```
			lineageTag: 0c94e014-ca35-473b-9af3-39cb9c50758e

			formatStringDefinition = "+0.00%;-0.00%;0.00%"

		measure 'MOM% Orders' = 

				VAR _MinDate = MIN('DateTable'[Date])
				VAR _MaxDate = MAX('DateTable'[Date])
				VAR _CM = [Orders]   -- Current Month selected orders
				VAR _PM =
				    CALCULATE(
				        SUM('Shopify Overall Share'[Orders__Shopify]),
				        DATESBETWEEN(
				            'DateTable'[Date],
				            EDATE(_MinDate, -1),
				            EDATE(_MaxDate, -1)
				        )
				    )
				RETURN
				DIVIDE(_CM - _PM, _PM)
			lineageTag: 1717865f-2832-4e03-90b7-b3f13190605d

